# Google Gemini API Key
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# MongoDB Atlas Database URI (Optional - For persistent cloud storage across Render restarts)
# Get your free cluster at: https://www.mongodb.com/atlas
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=threatlens_soc


